        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위 합계는 %1$@만 포함해요. 그 밖에 %2$@을(를) 썼어요(환산 안 함)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os totais acima estão só em %1$@. Também gasto: %2$@, sem conversão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Итоги выше — только в %1$@. Также потрачено %2$@ без пересчёта."
