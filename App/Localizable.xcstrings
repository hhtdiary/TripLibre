    "Saved as “Other” with your name for it, so it exports and analyses like Other." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحفظ باسم «أخرى» مع الاسم الذي اخترته، فيُصدَّر ويُحلَّل مثل «أخرى»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird als „Andere“ mit deinem Namen gespeichert, also wie „Andere“ exportiert und ausgewertet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda como «Otro» con tu nombre, así que se exporta y analiza como Otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré comme « Autre » avec votre nom, donc exporté et analysé comme Autre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「その他」としてあなたの名前付きで保存されるため、エクスポートや分析では「その他」扱いになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘기타’에 내가 붙인 이름으로 저장되므로 내보내기와 분석에서는 ‘기타’로 처리돼요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo como “Outro” com o seu nome, então é exportado e analisado como Outro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняется как «Другое» с вашим названием, поэтому экспортируется и анализируется как «Другое»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以“其他”类别加上你的命名保存，因此导出和分析时按“其他”处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以「其他」類別加上你的命名儲存，因此匯出和分析時按「其他」處理。"
          }
        }
      }
    },
    "Saved without coordinates. Download the airport list in Settings to get distances and map routes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُفظ بلا إحداثيات. نزّل قائمة المطارات من الإعدادات للحصول على المسافات والمسارات على الخريطة."
          }
        },
        "de" : {
          "stringUnit" : {
