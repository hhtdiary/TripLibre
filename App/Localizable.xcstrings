    "%@–%@. The trip stays one trip with two segments; both are kept when the day is reprocessed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@–%2$@. تبقى الرحلة رحلة واحدة بمقطعين؛ ويُحتفظ بكليهما عند إعادة معالجة اليوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@–%2$@. Die Fahrt bleibt eine Fahrt mit zwei Abschnitten; beide bleiben erhalten, wenn der Tag neu berechnet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@–%2$@. El viaje sigue siendo uno con dos tramos; ambos se conservan cuando se reprocesa el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@–%2$@. Le trajet reste un seul trajet en deux segments ; les deux sont conservés quand la journée est retraitée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@–%2$@。移動は 1 つのまま 2 区間になり、その日を再処理しても両方残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@–%2$@. 이동은 하나로 유지되며 구간이 둘로 나뉩니다. 하루를 다시 처리해도 둘 다 유지돼요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@–%2$@. A viagem continua sendo uma, com dois trechos; os dois são mantidos quando o dia for reprocessado."
          }
        },
        "ru" : {
          "stringUnit" : {
