          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 h menos el tiempo en lugares Casa, promediado sobre los días observados que incluyen una visita a Casa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 h moins le temps passé dans les lieux Domicile, en moyenne sur les jours observés comprenant une visite au Domicile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 時間から「自宅」の場所での時間を引いたもの。自宅への滞在を含む観測日で平均します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24시간에서 ‘집’ 장소에 있던 시간을 뺀 값으로, 집 방문이 있는 관측일의 평균입니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 h menos o tempo em lugares Casa, em média nos dias observados que incluem uma visita a Casa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 ч минус время в местах «Дом», в среднем по наблюдаемым дням, где был визит домой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 小时减去在“家”类地点的时间，对包含“家”停留的观测日取平均。"
