        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이동의 각 부분마다 구간을 추가하세요. 예: 지하철 후 도보."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um trecho para cada parte da viagem, por ex. metrô e depois a pé."
