    "Totals above are in %@ only. Also spent %@, not converted." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإجماليات أعلاه بعملة %1$@ فقط. أُنفق أيضًا %2$@ دون تحويل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Summen oben sind nur in %1$@. Außerdem ausgegeben: %2$@, nicht umgerechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los totales de arriba están solo en %1$@. También se gastó %2$@, sin convertir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les totaux ci-dessus sont en %1$@ uniquement. Dépensé aussi : %2$@, non converti."
