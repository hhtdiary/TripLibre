    "Recorded, not lost. It becomes a trip once you've stopped somewhere for ~5 minutes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسجَّل ولم يضِع. سيصبح رحلة بعد أن تتوقف في مكان ما نحو 5 دقائق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgezeichnet, nicht verloren. Daraus wird eine Fahrt, sobald du ~5 Minuten irgendwo angehalten hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grabado, no perdido. Se convertirá en un viaje cuando pares unos 5 minutos en algún sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré, pas perdu. Cela deviendra un trajet dès que vous vous serez arrêté ~5 minutes quelque part."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録済みで、失われていません。どこかで約 5 分とどまると移動になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록되었고 사라지지 않았어요. 어딘가에 약 5분 머무르면 이동이 됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gravado, não perdido. Vira uma viagem quando você ficar parado uns 5 minutos em algum lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записано, не потеряно. Это станет поездкой, когда вы где-нибудь остановитесь примерно на 5 минут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
