    "The sequence of trips from leaving a Home place to the next arrival at a Home place. Stops per tour = intermediate destinations." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسلسل الرحلات من مغادرة مكان «المنزل» حتى الوصول التالي إلى مكان «المنزل». التوقفات لكل جولة = الوجهات الوسيطة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Folge von Fahrten vom Verlassen eines Zuhause-Orts bis zur nächsten Ankunft an einem Zuhause-Ort. Halte pro Tour = Zwischenziele."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La secuencia de viajes desde que sales de un lugar Casa hasta la siguiente llegada a un lugar Casa. Paradas por circuito = destinos intermedios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suite de trajets entre le départ d’un lieu Domicile et l’arrivée suivante à un lieu Domicile. Arrêts par tournée = destinations intermédiaires."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自宅」の場所を出てから次に「自宅」の場所に着くまでの一連の移動。ツアーあたりの立ち寄り数 = 途中の目的地数。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘집’ 장소를 떠나 다음에 ‘집’ 장소에 도착할 때까지의 이동 순서. 투어당 정류 수 = 중간 목적지 수."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sequência de viagens desde a saída de um lugar Casa até a próxima chegada a um lugar Casa. Paradas por circuito = destinos intermediários."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последовательность поездок от выхода из места «Дом» до следующего прибытия в место «Дом». Остановки за тур = промежуточные пункты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从离开“家”类地点到下一次到达“家”类地点之间的行程序列。每条链的停靠数 = 中间目的地数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從離開「家」類地點到下一次到達「家」類地點之間的行程序列。每條鏈的停靠數 = 中間目的地數。"
          }
        }
      }
    },
    "The trip becomes two trips with a visit in between." : {
