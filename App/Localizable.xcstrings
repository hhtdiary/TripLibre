    "No costs logged in the last %@ yet. Tap + or answer my question on Today after a paid trip." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تكاليف مسجّلة في آخر %@ بعد. اضغط + أو أجب عن سؤالي في «اليوم» بعد رحلة مدفوعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In den letzten %@ noch keine Ausgaben. Tippe auf + oder beantworte nach einer bezahlten Fahrt meine Frage unter „Heute“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay gastos en los últimos %@. Toca + o responde a mi pregunta en Hoy después de un viaje de pago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune dépense notée sur les %@ derniers. Touchez + ou répondez à ma question dans Aujourd’hui après un trajet payant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直近 %@ の支出はまだありません。＋をタップするか、有料の移動のあと「今日」で質問に答えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 %@ 동안 기록된 지출이 없어요. +를 탭하거나, 유료 이동 후 오늘 탭에서 제 질문에 답해 주세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há gastos nos últimos %@. Toque em + ou responda à minha pergunta em Hoje depois de uma viagem paga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За последние %@ расходов пока нет. Нажмите + или ответьте на мой вопрос на вкладке «Сегодня» после платной поездки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近 %@ 还没有记录花费。轻点 +，或在付费出行后回答“今天”页上的提问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近 %@ 還沒有記錄花費。點一下 +，或在付費出行後回答「今天」頁上的提問。"
          }
        }
      }
    },
