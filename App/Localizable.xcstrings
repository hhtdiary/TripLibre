    "Add a segment for each part of the trip, e.g. subway, then walk." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف مقطعًا لكل جزء من الرحلة، مثل المترو ثم المشي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge für jeden Teil der Fahrt einen Abschnitt hinzu, z. B. U-Bahn, dann zu Fuß."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un tramo por cada parte del viaje, p. ej. metro y luego a pie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un segment pour chaque partie du trajet, par ex. métro puis marche."
