    "24 h minus time at Home places, averaged over observed days that include a Home visit." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 ساعة ناقص الوقت في أماكن «المنزل»، بمتوسط على الأيام المرصودة التي تتضمن زيارة للمنزل."
          }
        },
        "de" : {
          "stringUnit" : {
