    "Only places you saved, found on this iPhone. Nothing is picked for you; the detected stop stays as recorded." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅列出你保存过的地点，在这台 iPhone 上查找。不会替你自动选择；检测到的停留保持原样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只列出你儲存過的地點，在這台 iPhone 上查找。不會替你自動選擇；偵測到的停留維持原樣。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement les lieux que vous avez enregistrés, trouvés sur cet iPhone. Rien n’est choisi à votre place ; l’arrêt détecté reste tel qu’enregistré."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Orte, die du gespeichert hast, auf diesem iPhone gesucht. Nichts wird für dich ausgewählt; der erkannte Halt bleibt wie aufgezeichnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los lugares que guardaste, buscados en este iPhone. No se elige nada por ti; la parada detectada queda tal como se registró."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas os lugares que você salvou, buscados neste iPhone. Nada é escolhido por você; a parada detectada fica como foi registrada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только сохранённые вами места, поиск на этом iPhone. Ничего не выбирается за вас; обнаруженная остановка остаётся как записана."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأماكن التي حفظتها فقط، يُبحث عنها على هذا الـ iPhone. لا يُختار شيء نيابةً عنك؛ وتبقى المحطة المكتشفة كما سُجّلت."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した場所だけを、この iPhone 上で探します。自動では選ばれず、検出された滞在は記録どおりのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장한 장소만 이 iPhone에서 찾습니다. 자동으로 선택하지 않으며, 감지된 머문 곳은 기록된 그대로 유지됩니다."
          }
        }
      }
    },
    "Only the list is downloaded; nothing about you is sent." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنزَّل القائمة فقط؛ ولا يُرسَل أي شيء عنك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Liste wird geladen; nichts über dich wird gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se descarga la lista; no se envía nada sobre ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule la liste est téléchargée ; rien vous concernant n’est envoyé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードするのはリストだけで、あなたの情報は何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록만 다운로드하며 내 정보는 아무것도 전송되지 않아요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só a lista é baixada; nada sobre você é enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружается только список; о вас ничего не отправляется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会下载列表，不会发送任何关于你的信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會下載列表，不會傳送任何關於你的資訊。"
          }
        }
      }
    },
    "Only trips with a cost entered (free ones included) count here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
