    "Shannon entropy (bits) of the distribution of visits over places. 0 = always the same place; higher = visits spread across more places." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنتروبيا شانون (بت) لتوزيع الزيارات على الأماكن. 0 = المكان نفسه دائمًا؛ أعلى = زيارات موزعة على أماكن أكثر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shannon-Entropie (Bit) der Verteilung der Aufenthalte auf Orte. 0 = immer derselbe Ort; höher = Aufenthalte auf mehr Orte verteilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entropía de Shannon (bits) de la distribución de visitas entre lugares. 0 = siempre el mismo lugar; más alto = visitas repartidas en más lugares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entropie de Shannon (bits) de la répartition des visites entre les lieux. 0 = toujours le même lieu ; plus élevé = visites réparties sur plus de lieux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所ごとの訪問分布のシャノンエントロピー（ビット）。0 = いつも同じ場所、値が大きいほど多くの場所に分散。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장소별 방문 분포의 섀넌 엔트로피(비트). 0 = 늘 같은 장소, 높을수록 더 많은 장소에 방문이 흩어짐."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entropia de Shannon (bits) da distribuição das visitas pelos lugares. 0 = sempre o mesmo lugar; maior = visitas espalhadas por mais lugares."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Энтропия Шеннона (бит) распределения визитов по местам. 0 — всегда одно и то же место; выше — визиты распределены по большему числу мест."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停留在各地点分布的香农熵（比特）。0 = 总在同一个地点；越高 = 停留分散在越多地点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停留在各地點分布的夏農熵（位元）。0 = 總在同一個地點；越高 = 停留分散在越多地點。"
          }
        }
      }
    },
    "Shannon entropy (bits) of trips over modes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنتروبيا شانون (بت) للرحلات حسب الوسيلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shannon-Entropie (Bit) der Fahrten über die Verkehrsmittel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entropía de Shannon (bits) de los viajes por modo."
          }
        },
        "fr" : {
