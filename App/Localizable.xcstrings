    "You made %@ across %@, %lld more than %@. Busy bee!" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قمت بـ%1$@ خلال %2$@، أي %3$lld أكثر من %4$@. نشيط جدًا!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hattest %1$@ an %2$@, %3$lld mehr als %4$@. Fleißig!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiciste %1$@ en %2$@, %3$lld más que %4$@. ¡Qué actividad!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez fait %1$@ sur %2$@, %3$lld de plus que %4$@. Quelle activité !"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@で %1$@、%4$@より %3$lld 件多いです。大活躍！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 동안 %1$@, %4$@보다 %3$lld건 많아요. 정말 바빴네요!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você fez %1$@ em %2$@, %3$lld a mais que %4$@. Que agito!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас %1$@ за %2$@ — на %3$lld больше, чем за %4$@. Как пчёлка!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 %2$@里完成了 %1$@，比%4$@多 %3$lld 段。真是大忙人！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 %2$@裡完成了 %1$@，比%4$@多 %3$lld 段。真是大忙人！"
          }
        }
      }
    },
