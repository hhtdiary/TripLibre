    "Motion & Fitness activity helps tell walking, cycling and vehicles apart." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يساعد نشاط «الحركة واللياقة» على التمييز بين المشي وركوب الدراجة والمركبات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegung & Fitness hilft, Gehen, Radfahren und Fahrzeuge zu unterscheiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actividad de Movimiento y forma física ayuda a distinguir entre caminar, ir en bici y en vehículo."
