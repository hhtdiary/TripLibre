    "Location “Always” lets it log trips in the background. It uses GPS only while you're moving." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح إذن الموقع «دائمًا» تسجيل الرحلات في الخلفية. لا يُستخدم GPS إلا أثناء تحرّكك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standort „Immer“ erlaubt das Aufzeichnen im Hintergrund. GPS läuft nur, während du dich bewegst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación «Siempre» permite registrar viajes en segundo plano. Solo usa el GPS mientras te mueves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position « Toujours » permet d’enregistrer les trajets en arrière-plan. Le GPS n’est utilisé que pendant vos déplacements."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報を「常に」にするとバックグラウンドで移動を記録できます。GPS は移動中だけ使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 ‘항상’을 허용하면 백그라운드에서 이동을 기록해요. GPS는 이동 중에만 사용해요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localização “Sempre” permite registrar viagens em segundo plano. O GPS só é usado enquanto você se move."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к геопозиции «Всегда» позволяет записывать поездки в фоне. GPS работает, только пока вы движетесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置权限设为“始终”后可在后台记录行程。只在你移动时使用 GPS。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置權限設為「永遠」後可在背景記錄行程。只在你移動時使用 GPS。"
          }
        }
      }
    },
