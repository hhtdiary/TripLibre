    "How far from a stop to look for places you saved when you review it. Searched on this iPhone only." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看停留时，在多远范围内查找你保存的地点。仅在这台 iPhone 上搜索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢視停留時，在多遠範圍內查找你儲存的地點。只在這台 iPhone 上搜尋。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance autour d’un arrêt où chercher vos lieux enregistrés quand vous le vérifiez. Recherche sur cet iPhone uniquement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit um einen Halt nach gespeicherten Orten gesucht wird, wenn du ihn prüfst. Nur auf diesem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta qué distancia de una parada buscar tus lugares guardados al revisarla. Solo se busca en este iPhone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A que distância de uma parada procurar seus lugares salvos ao revisá-la. A busca é feita só neste iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как далеко от остановки искать сохранённые места при её проверке. Поиск только на этом iPhone."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المسافة حول المحطة التي يُبحث فيها عن أماكنك المحفوظة عند مراجعتها. البحث على هذا الـ iPhone فقط."
