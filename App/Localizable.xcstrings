    "Periods like a semester, a job or a city of residence. Stats can be computed and compared per phase." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فترات مثل فصل دراسي أو وظيفة أو مدينة إقامة. يمكن حساب الإحصاءات ومقارنتها لكل مرحلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeiträume wie ein Semester, ein Job oder ein Wohnort. Statistiken lassen sich je Phase berechnen und vergleichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periodos como un semestre, un trabajo o una ciudad de residencia. Las estadísticas pueden calcularse y compararse por etapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des périodes comme un semestre, un emploi ou une ville de résidence. Les statistiques peuvent être calculées et comparées par période."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学期、仕事、住んでいた街などの期間です。ステージごとに統計を計算・比較できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "학기, 직장, 거주 도시 같은 기간입니다. 단계별로 통계를 계산하고 비교할 수 있어요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Períodos como um semestre, um emprego ou uma cidade onde você morou. As estatísticas podem ser calculadas e comparadas por fase."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Периоды вроде семестра, работы или города проживания. Статистику можно считать и сравнивать по этапам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如一个学期、一份工作或一段居住城市的时期。可以按阶段计算和比较统计数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如一個學期、一份工作或一段居住城市的時期。可以按階段計算和比較統計資料。"
          }
        }
      }
    },
