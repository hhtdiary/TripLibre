    "System default" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتراضي النظام"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemstandard"
          }
        },
        "es" : {
          "stringUnit" : {
