    "Stamped at %@. I'll fit it into your day." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خُتم عند %@. سأضعه في مكانه من يومك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um %@ gestempelt. Ich ordne es in deinen Tag ein."
