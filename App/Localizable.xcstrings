    "Creates the missing trip(s). Places must exist already — create one from any visit or in Places." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ الرحلة (أو الرحلات) الناقصة. يجب أن تكون الأماكن موجودة — أنشئ مكانًا من أي زيارة أو من «الأماكن»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt die fehlenden Fahrten an. Orte müssen schon existieren – lege einen bei einem Aufenthalt oder unter „Orte“ an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea los viajes que faltan. Los lugares deben existir ya: crea uno desde cualquier visita o en Lugares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée le ou les trajets manquants. Les lieux doivent déjà exister — créez-en un depuis une visite ou dans Lieux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抜けている移動を作成します。場所はあらかじめ必要です。滞在の画面か「場所」で作成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠진 이동을 만들어요. 장소가 이미 있어야 하니, 아무 방문이나 장소 탭에서 만들어 주세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cria as viagens que faltam. Os lugares já precisam existir — crie um a partir de qualquer visita ou em Lugares."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создаёт недостающие поездки. Места должны уже существовать — создайте место из любого визита или во вкладке «Места»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会创建缺失的行程。地点必须已存在——可从任意停留或在“地点”中创建。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會建立缺少的行程。地點必須已存在——可從任一停留或在「地點」中建立。"
          }
        }
      }
    },
